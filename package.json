{
  "name": "@local/dsh-thinking-highlight",
  "version": "1.0.0",
  "private": true,
  "description": "Chain-of-thought keyword highlighting with a keyword-count chip, an eye toggle in the thinking row, and a settings row",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "标红插件",
    "description": "思维链关键词标红，思考行里显示提示词出现次数的徽章与高亮开关；设置里可改语言、插件开关、大小写与关键词颜色。"
  }
}
